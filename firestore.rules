rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 世界ランキング：匿名ログインした人なら誰でも読める・追加できる
    // 更新・削除はルールに書かないので禁止（荒らされたらコンソールから消す）
    match /rankings/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        // アプリが送る5項目だけ（余計な項目は不可）
        && request.resource.data.keys().hasOnly(['name', 'seconds', 'period', 'style', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'seconds', 'period', 'style', 'createdAt'])
        // 名前：1〜20文字（入力欄の maxlength と同じ）
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        // タイム（秒）：5秒以上24時間未満の整数
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 5
        && request.resource.data.seconds < 86400
        // 周期・スタイル：index.html の選択肢と同じ値だけ
        && request.resource.data.period in ['3', '4', '5', '6', '7', '6+Ac', '7+La+Ac']
        && request.resource.data.style in ['drag', 'type']
        // 投稿日時：サーバーの時刻だけ
        && request.resource.data.createdAt == request.time;
    }
  }
}
